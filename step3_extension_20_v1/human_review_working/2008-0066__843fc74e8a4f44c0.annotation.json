      "clause_path": "Ref. Publications",
      "exact_quote": "Ref. Publications: AIRBUS Service Bulletins A310-54-2036 revision 1, revision 2; and A310-54-2032 original issue; The use of later approved revisions of these documents is acceptable for compliance with the requirements of this AD.",
      "start_char": null,
      "end_char": null,
      "page_text_sha256": "5c43cf29948b745426eaf277e42dae902601832454c41057fa3a6b8d863abcb2",
