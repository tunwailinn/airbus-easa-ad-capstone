      "section_raw": "Compliance:",
      "clause_path": "compliance",
      "exact_quote": "Compliance: The following measures are required from the effective date of this AD: (1) Perform an High Frequency Eddy Current (HFEC) inspection and a detailed visual inspection on the lower side of Rib 5 of LH and RH pylon in accordance with the instructions defined in AIRBUS SB A310-54-2036 Revision 2 at the 1/2",
      "start_char": null,
      "end_char": null,
      "page_text_sha256": "2ee7b4731b17a059289b5dc197d10408942dae6eb578d7eec2fca6a1d47d0b13",
      "bbox_normalized": null,
      "extraction_method": "native_text",
      "quality": "normalized_whitespace",
      "table_context": null,
