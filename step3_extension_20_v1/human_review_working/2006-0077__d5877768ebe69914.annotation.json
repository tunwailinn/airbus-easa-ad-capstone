  "definitions": [],
  "unsafe_condition": {
    "state": "present",
    "raw_reason_text": "Reason: A study has shown that the architecture of the BRUCE FPEEPMS is not in compliance with regulatory requirement FAR 25.812 as, in case of vertical segregation of the fuselage forward of door 1, the FPEEPMS and the EXIT signs do not come on. Airworthiness Directive (AD) 2004-102, which dealt with the same subject, rendered mandatory modifications to the FPEEPMS to ensure its operation in compliance with the regulatory requirements. SBs A310-33-2045 and A300-33-6047 at original issue were issued for this purpose. However, it turns out that the instructions given in the original issues of these SBs were not fully satisfactory. This is the reason why AD 2004-102 had been cancelled and this AD renders mandatory the embodiment of revision 1 of these SBs.",
    "observed_events_or_defects": [
      "A study has shown that the architecture of the BRUCE FPEEPMS is not in compliance with regulatory requirement FAR 25.812 as, in case of vertical segregation of the fuselage forward of door 1, the FPEEPMS and the EXIT signs do not come on."
    ],
