{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/capstone/schemas/easa-airbus-ad-annotation-1.0.0.json",
  "title": "Evidence-grounded EASA Airbus AD annotation",
  "description": "One annotation record for one canonical EASA Airbus Airworthiness Directive publication, revision, or correction. Missing scalar values use null and missing collections use empty arrays.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "source_document",
    "ad_identity",
    "publication",
    "applicability_groups",
    "definitions",
    "unsafe_condition",
    "requirements",
    "exceptions",
    "previous_action_credit",
    "referenced_publications",
    "relationships",
    "amoc_and_contacts",
    "classification",
    "evidence_spans",
    "field_assertions",
    "annotation_metadata",
    "benchmark_metadata"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "record_id": {
      "type": "string",
      "pattern": "^adann-[a-f0-9]{16}$"
    },
    "source_document": {
      "$ref": "#/$defs/source_document"
    },
    "ad_identity": {
      "$ref": "#/$defs/ad_identity"
    },
    "publication": {
      "$ref": "#/$defs/publication"
    },
    "applicability_groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/applicability_group"
      }
    },
    "definitions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/definition"
      }
    },
    "unsafe_condition": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/unsafe_condition"
        }
      ]
    },
    "requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/requirement"
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exception"
      }
    },
    "previous_action_credit": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/previous_action_credit"
      }
    },
    "referenced_publications": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/publication_reference"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      }
    },
    "amoc_and_contacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/amoc_contact"
      }
    },
    "classification": {
      "$ref": "#/$defs/classification"
    },
    "evidence_spans": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence_span"
      }
    },
    "field_assertions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/field_assertion"
      }
    },
    "annotation_metadata": {
      "$ref": "#/$defs/annotation_metadata"
    },
    "benchmark_metadata": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/benchmark_metadata"
        }
      ]
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "nullable_string": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "date_or_null": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "date_time_or_null": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "evidence_id": {
      "type": "string",
      "pattern": "^EV-[0-9]{3,}$"
    },
    "evidence_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/evidence_id"
      }
    },
    "field_state": {
      "enum": [
        "present",
        "explicit_none",
        "not_stated",
        "illegible",
        "ambiguous",
        "conflicting"
      ]
    },
    "grounded_text": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "value",
        "raw_text",
        "evidence_ids"
      ],
      "properties": {
        "state": {
          "$ref": "#/$defs/field_state"
        },
        "value": {
          "$ref": "#/$defs/nullable_string"
        },
        "raw_text": {
          "$ref": "#/$defs/nullable_string"
        },
        "evidence_ids": {
          "$ref": "#/$defs/evidence_ids"
        }
      }
    },
    "grounded_date": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "value",
        "raw_text",
        "evidence_ids"
      ],
      "properties": {
        "state": {
          "$ref": "#/$defs/field_state"
        },
        "value": {
          "$ref": "#/$defs/date_or_null"
        },
        "raw_text": {
          "$ref": "#/$defs/nullable_string"
        },
        "evidence_ids": {
          "$ref": "#/$defs/evidence_ids"
        }
      }
    },
    "source_document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file_instance_id",
        "content_id",
        "canonical_file_instance_id",
        "file_aliases",
        "file_name",
        "relative_path",
        "file_sha256",
        "normalized_text_sha256",
        "page_count",
        "extraction_status",
        "needs_ocr",
        "manifest_review_flags",
        "source_url",
        "text_extraction_method",
        "exact_duplicate_group",
        "near_duplicate_cluster"
      ],
      "properties": {
        "file_instance_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{16}$"
        },
        "content_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{16,64}$"
        },
        "canonical_file_instance_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{16}$"
        },
        "file_aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "file_name": {
          "$ref": "#/$defs/non_empty_string"
        },
        "relative_path": {
          "$ref": "#/$defs/non_empty_string"
        },
        "file_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "normalized_text_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "page_count": {
          "type": "integer",
          "minimum": 1
        },
        "extraction_status": {
          "enum": [
            "ok",
            "native_text",
            "low_text",
            "ocr_required",
            "ocr_complete",
            "hybrid",
            "failed"
          ]
        },
        "needs_ocr": {
          "type": "boolean"
        },
        "manifest_review_flags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "text_extraction_method": {
          "enum": [
            "native_text",
            "ocr",
            "hybrid",
            "visual_transcription"
          ]
        },
        "exact_duplicate_group": {
          "$ref": "#/$defs/nullable_string"
        },
        "near_duplicate_cluster": {
          "$ref": "#/$defs/nullable_string"
        }
      }
    },
    "ad_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "document_type",
        "ad_number",
        "base_ad_number",
        "revision_number",
        "publication_kind",
        "is_emergency",
        "is_correction",
        "correction_date",
        "version_label",
        "logical_version_key",
        "is_latest_version",
        "lifecycle_status",
        "design_approval_holder",
        "supersedure_statement",
        "evidence_ids"
      ],
      "properties": {
        "authority": {
          "const": "EASA"
        },
        "document_type": {
          "const": "airworthiness_directive"
        },
        "ad_number": {
          "type": "string",
          "pattern": "^(?:19|20)[0-9]{2}-[0-9]{4}(?:R[1-9][0-9]*)?(?:-E)?$"
        },
        "base_ad_number": {
          "type": "string",
          "pattern": "^(?:19|20)[0-9]{2}-[0-9]{4}$"
        },
        "revision_number": {
          "type": "integer",
          "minimum": 0
        },
        "publication_kind": {
          "enum": [
            "standard_ad",
            "emergency_ad"
          ]
        },
        "is_emergency": {
          "type": "boolean"
        },
        "is_correction": {
          "type": "boolean"
        },
        "correction_date": {
          "$ref": "#/$defs/grounded_date"
        },
        "version_label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "logical_version_key": {
          "$ref": "#/$defs/non_empty_string"
        },
        "is_latest_version": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "lifecycle_status": {
          "enum": [
            "active",
            "superseded",
            "cancelled",
            "unknown"
          ]
        },
        "design_approval_holder": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/grounded_text"
            }
          ]
        },
        "supersedure_statement": {
          "$ref": "#/$defs/grounded_text"
        },
        "evidence_ids": {
          "$ref": "#/$defs/evidence_ids"
        }
      }
    },
    "ata_chapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "title",
        "evidence_ids"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[0-9]{2}$"
        },
        "title": {
          "$ref": "#/$defs/nullable_string"
        },
        "evidence_ids": {
          "$ref": "#/$defs/evidence_ids"
        }
      }
    },
    "manufacturer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_name",
        "normalized_name",
        "role",
        "evidence_ids"
      ],
      "properties": {
        "raw_name": {
          "$ref": "#/$defs/non_empty_string"
        },
        "normalized_name": {
          "$ref": "#/$defs/non_empty_string"
        },
        "role": {
          "enum": [
            "manufacturer",
            "former_manufacturer_name",
            "design_approval_holder",
            "stc_holder",
            "other"
          ]
        },
        "evidence_ids": {
          "$ref": "#/$defs/evidence_ids"
        }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "issue_date",
        "effective_date",
        "ata_chapters",
        "manufacturers",
        "type_model_designations",
        "tcds_numbers",
        "foreign_ad"
      ],
      "properties": {
        "subject": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/grounded_text"
            }
          ]
        },
        "issue_date": {
          "$ref": "#/$defs/grounded_date"
        },
        "effective_date": {
          "$ref": "#/$defs/grounded_date"
        },
        "ata_chapters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ata_chapter"
          }
        },
        "manufacturers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/manufacturer"
          }
        },
        "type_model_designations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "tcds_numbers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "foreign_ad": {
          "$ref": "#/$defs/grounded_text"
        }
      }
    },
    "serial_restriction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "restriction_id",
        "kind",
        "raw_expression",
        "lower_bound",
        "upper_bound",
        "explicit_values",
        "condition",
        "evidence_ids"
      ],
      "properties": {
        "restriction_id": {
          "type": "string",
          "pattern": "^MSN-[0-9]{3,}$"
        },
        "kind": {
          "enum": [
            "all",
            "include_range",
            "exclude_range",
            "include_list",
            "exclude_list",
            "conditional",
            "other"
          ]
        },
        "raw_expression": {
          "$ref": "#/$defs/non_empty_string"
        },
        "lower_bound": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "upper_bound": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "explicit_values": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "condition": {
          "$ref": "#/$defs/nullable_string"
        },
        "evidence_ids": {
          "$ref": "#/$defs/evidence_ids"
        }
      }
    },
    "applicability_group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "group_id",
        "label",
        "state",
        "raw_text",
        "aircraft_families",
        "models",
        "serial_restrictions",
        "part_numbers",
        "configuration_conditions",
        "exclusions",
        "boolean_logic",
        "evidence_ids"
      ],
      "properties": {
        "group_id": {
          "type": "string",
          "pattern": "^APP-[0-9]{3,}$"
        },
        "label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "state": {
          "$ref": "#/$defs/field_state"
        },
        "raw_text": {
          "$ref": "#/$defs/non_empty_string"
        },
        "aircraft_families": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "models": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "serial_restrictions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/serial_restriction"
          }
        },
        "part_numbers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "configuration_conditions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "exclusions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "boolean_logic": {
          "enum": [
            "all",
            "any",
            "mixed",
            "not_applicable"
          ]
        },
        "evidence_ids": {
          "$ref": "#/$defs/evidence_ids"
        }
      }
    },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "definition_id",
        "term",
        "definition_text",
        "evidence_ids"
      ],
      "properties": {
        "definition_id": {
          "type": "string",
          "pattern": "^DEF-[0-9]{3,}$"
        },
        "term": {
          "$ref": "#/$defs/non_empty_string"
        },
        "definition_text": {
          "$ref": "#/$defs/non_empty_string"
        },
        "evidence_ids": {
          "$ref": "#/$defs/evidence_ids"
        }
      }
    },
    "unsafe_condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "raw_reason_text",
        "observed_events_or_defects",
        "causes",
        "unsafe_conditions",
        "potential_consequences",
        "affected_components",
        "intended_risk_mitigation",
        "evidence_ids"
      ],
      "properties": {
        "state": {
          "$ref": "#/$defs/field_state"
        },
        "raw_reason_text": {
          "$ref": "#/$defs/non_empty_string"
        },
        "observed_events_or_defects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "causes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "unsafe_conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "potential_consequences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "affected_components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "intended_risk_mitigation": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "evidence_ids": {
          "$ref": "#/$defs/evidence_ids"
        }
      }
    },
    "compliance_limit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "limit_id",
        "relation",
        "quantity",
        "unit",
        "raw_value",
        "reference_event",
        "calendar_date",
        "evidence_ids"
      ],
      "properties": {
        "limit_id": {
          "type": "string",
          "pattern": "^LIM-[0-9]{3,}$"
        },
        "relation": {
          "enum": [
            "within",
            "before",
            "after",
            "at",
            "not_later_than",
            "not_to_exceed",
            "upon",
            "from",
            "other"
          ]
        },
        "quantity": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "unit": {
          "enum": [
            "flight_hour",
            "flight_cycle",
            "landing",
            "calendar_hour",
            "calendar_day",
            "calendar_month",
            "calendar_year",
            "before_next_flight",
            "next_scheduled_check",
            "calendar_date",
            "engine_cycle",
            "apu_cycle",
            "other"
          ]
        },
        "raw_value": {
          "$ref": "#/$defs/non_empty_string"
        },
        "reference_event": {
          "$ref": "#/$defs/nullable_string"
        },
        "calendar_date": {
          "$ref": "#/$defs/date_or_null"
        },
        "evidence_ids": {
          "$ref": "#/$defs/evidence_ids"
        }
      }
    },
    "compliance_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compliance_id",
        "state",
        "raw_text",
        "logic",
        "conditions",
        "initial_limits",
        "is_repetitive",
        "repetitive_intervals",
        "grace_periods",
        "evidence_ids"
      ],
      "properties": {
        "compliance_id": {
          "type": "string",
          "pattern": "^CMP-[0-9]{3,}$"
        },
        "state": {
          "$ref": "#/$defs/field_state"
        },
        "raw_text": {
          "$ref": "#/$defs/non_empty_string"
        },
        "logic": {
          "enum": [
            "single",
            "all",
            "any",
            "whichever_occurs_first",
            "whichever_occurs_later",
            "conditional"
          ]
        },
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "initial_limits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/compliance_limit"
          }
        },
        "is_repetitive": {
          "type": "boolean"
        },
        "repetitive_intervals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/compliance_limit"
          }
        },
        "grace_periods": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/compliance_limit"
          }
        },
        "evidence_ids": {
          "$ref": "#/$defs/evidence_ids"
        }
      }
    },
    "terminating_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "present",
        "scope",
        "action_text",
        "terminates_requirement_ids",
        "evidence_ids"
      ],
      "properties": {
        "state": {
          "$ref": "#/$defs/field_state"
        },
        "present": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "scope": {
          "enum": [
            "none",
            "partial",
            "full",
            "unknown"
          ]
        },
        "action_text": {
          "$ref": "#/$defs/nullable_string"
        },
        "terminates_requirement_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^REQ-[0-9]{3,}$"
          }
        },
        "evidence_ids": {
          "$ref": "#/$defs/evidence_ids"
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_id",
        "paragraph_reference",
        "parent_requirement_id",
        "applicability_group_ids",
        "action_types",
        "obligation",
        "action_text",
        "objects_or_components",
        "conditions",
        "method_publication_ids",
        "compliance_rules",
        "follow_on_requirement_ids",
        "terminating_action",
        "evidence_ids"
      ],
      "properties": {
        "requirement_id": {
          "type": "string",
          "pattern": "^REQ-[0-9]{3,}$"
        },
        "paragraph_reference": {
          "$ref": "#/$defs/nullable_string"
        },
        "parent_requirement_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^REQ-[0-9]{3,}$"
        },
        "applicability_group_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
