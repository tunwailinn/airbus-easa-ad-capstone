{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "e5-hosted-qa-contract-v1.0",
  "title": "E5 Layer C hosted QA model response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "answer",
    "conditions",
    "compliance_time",
    "exceptions",
    "evidence_ids",
    "reason_for_abstention"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "answered",
        "insufficient_evidence",
        "conflicting_evidence"
      ]
    },
    "answer": {
      "type": "string",
      "minLength": 1
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "compliance_time": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^EV[1-9][0-9]*$"
      }
    },
    "reason_for_abstention": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "answered"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "evidence_ids": {
            "minItems": 1
          },
          "reason_for_abstention": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "insufficient_evidence",
              "conflicting_evidence"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "reason_for_abstention": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
