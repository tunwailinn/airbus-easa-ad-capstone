      "section_raw": null,
      "clause_path": "Ref. Publications",
      "exact_quote": "Ref. Publications:\n     LHT DCS AQD-23-DCS-09 rev. 0 dated 20 May 2025 and rev. 1 dated 14 January 2026.\n\n     The use of later approved revisions of            the above-mentioned document is acceptable for compliance\n     with the requirements of this AD.",
      "start_char": 1996,
