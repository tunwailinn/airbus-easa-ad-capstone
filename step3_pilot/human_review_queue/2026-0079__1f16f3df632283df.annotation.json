      "section": "remarks",
      "section_raw": null,
      "clause_path": "Remarks 1-2",
      "exact_quote": "Remarks:\n     1.    If requested and appropriately substantiated, EASA can approve Alternative Methods of\n           Compliance for this AD.\n\n     2.    Based on the required actions and the compliance time, EASA have decided to issue a Final AD\n           with Request for Comments, postponing the public consultation process until after publication.\n           All interested persons may send their comments, referencing the AD Number, to the E-mail\n           address specified in below Remark 3, prior to 15 May 2026. Only if any comment is received\n           during the consultation period, a Comment Response Document will be published in the EASA\n           Safety Publications Tool, in a compressed (‘zipped’) file, attached to the record for this AD.",
      "start_char": 2260,
      "end_char": 3020,
      "page_text_sha256": "83411b4f9d6e457f626d7f1f368967b7cb512fdfa385519e37951d2363790ae4",
      "bbox_normalized": null,
