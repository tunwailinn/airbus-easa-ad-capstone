    {
      "evidence_id": "EV-009",
      "source_file_instance_id": "5577514a19f6917c",
      "page_number": 1,
      "printed_page_label": "Page 1 of 2",
      "section": "reason",
      "section_raw": null,
      "clause_path": "Reason",
      "exact_quote": "Reason:\n      The function of the cargo lining gutter assembly is to collect floor umbrella drainage, condensation\n      water from ceiling panels, system port drainage, potable water shroud drainage and supplemental\n      cooling system shroud drainage. As a result of investigations and analysis by Airbus, it was identified\n      that this assembly would not be able to correctly drain a certain quantity of water in case of potable",
      "start_char": 2481,
      "end_char": 2916,
      "page_text_sha256": "737cdb59e091938c565b24e28faaae7400b7574e4db753d962c06dd2c28e4bdd",
      "bbox_normalized": null,
      "extraction_method": "native_text",
      "quality": "normalized_whitespace",
      "table_context": null,
      "annotation_note": null
    },
    {
      "evidence_id": "EV-010",
      "source_file_instance_id": "5577514a19f6917c",
      "page_number": 2,
      "printed_page_label": "Page 2 of 2",
      "section": "reason",
      "section_raw": null,
      "clause_path": "Reason (continued)",
      "exact_quote": "water distribution pipe leakage, or rupture of the pipe close to the electronics bay entrance. This\n     could lead to overflow and create the risk of water spillage during flight.\n\n     This condition, if not corrected, could lead to fluid contamination of certain electrical equipment\n     and connectors, possibly resulting in the loss of several flight control functions, with consequent\n     reduced control of the aeroplane.",
      "start_char": 134,
      "end_char": 564,
      "page_text_sha256": "e6b14fd4061c82d23da15ef8241ede7a38df9fe96e3ea5082582904b95bf74e9",
      "bbox_normalized": null,
      "extraction_method": "native_text",
      "quality": "normalized_whitespace",
      "table_context": null,
      "annotation_note": null
    },
    {
      "evidence_id": "EV-011",
      "source_file_instance_id": "5577514a19f6917c",
      "page_number": 2,
      "printed_page_label": "Page 2 of 2",
      "section": "reason",
      "section_raw": null,
      "clause_path": "Reason / affected components and mitigation",
      "exact_quote": "To address this potential unsafe condition, affecting components located on the rear side of the\n     surrounding avionics racks 1100 View Unit (VU) and 1200 VU, related to the functioning of all PRIM,\n     SEC1 and SEC2, 4 pairs of spoilers and left elevator, Airbus issued the SB to introduce a new drain\n     gutter design with improved outlets on both sides for a better water drainage.",
      "start_char": 571,
      "end_char": 961,
      "page_text_sha256": "e6b14fd4061c82d23da15ef8241ede7a38df9fe96e3ea5082582904b95bf74e9",
      "bbox_normalized": null,
      "extraction_method": "native_text",
      "quality": "normalized_whitespace",
      "table_context": null,
      "annotation_note": null
    },
    {
      "evidence_id": "EV-012",
      "source_file_instance_id": "5577514a19f6917c",
      "page_number": 2,
      "printed_page_label": "Page 2 of 2",
      "section": "required_actions_and_compliance_times",
      "section_raw": "Modification",
      "clause_path": "Modification",
      "exact_quote": "Before exceeding 80 months since Airbus date of manufacture, modify the cargo lining gutter\n     assemblies in accordance with the instructions of the SB.",
      "start_char": 1204,
      "end_char": 1358,
      "page_text_sha256": "e6b14fd4061c82d23da15ef8241ede7a38df9fe96e3ea5082582904b95bf74e9",
      "bbox_normalized": null,
      "extraction_method": "native_text",
