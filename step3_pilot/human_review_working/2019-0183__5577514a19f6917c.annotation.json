      "clause_path": "Definitions / Airbus date of manufacture",
      "exact_quote": "Airbus date of manufacture: The date of transfer of title (ownership) of the aeroplane upon\n      delivery by Airbus to the first operator.",
      "start_char": 2334,
      "end_char": 2473,
      "page_text_sha256": "737cdb59e091938c565b24e28faaae7400b7574e4db753d962c06dd2c28e4bdd",
      "bbox_normalized": null,
      "extraction_method": "native_text",
