      "source_file_instance_id": "75144c1f05797c10",
      "page_number": 2,
      "printed_page_label": "Page 2 of 2",
      "section": "reason",
      "section_raw": "Reason continued",
      "clause_path": null,
      "exact_quote": "This condition, if not corrected, could lead to failure of the door to perform its intended function, possibly resulting in reduced evacuation capacity from the aeroplane during an emergency and consequent injury to occupants. To address this unsafe condition, Airbus developed production mod 110790 and mod 109554 to improve protection against corrosion, and issued the SB to provide modification instructions for in-service pre-mod aeroplanes. For the reasons described above, this AD requires a modification by adding sealant and protective treatment on the affected passenger doors.",
      "start_char": null,
      "end_char": null,
      "page_text_sha256": "46ba3a3e2d0213a8dbaa8403aa03a85ca6f071ad2ae892e244a1940b75f568f9",
      "bbox_normalized": null,
      "extraction_method": "native_text",
      "quality": "normalized_whitespace",
      "table_context": null,
      "annotation_note": null
    },
    {
      "evidence_id": "EV-007",
      "source_file_instance_id": "75144c1f05797c10",
      "page_number": 2,
      "printed_page_label": "Page 2 of 2",
      "section": "required_actions_and_compliance_times",
      "section_raw": "Required Action(s) and Compliance Time(s)",
      "clause_path": null,
      "exact_quote": "Modification: Before exceeding 48 months since the aeroplane date of manufacture, apply additional corrosion protection to the hybrid joints of the doors 1, 2, 3 and 4, left-hand and right-hand sides, in accordance with the instructions of the SB.",
      "start_char": null,
      "end_char": null,
      "page_text_sha256": "46ba3a3e2d0213a8dbaa8403aa03a85ca6f071ad2ae892e244a1940b75f568f9",
