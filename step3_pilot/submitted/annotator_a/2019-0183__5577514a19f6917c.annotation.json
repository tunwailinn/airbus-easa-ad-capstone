      "table_context": null,
      "annotation_note": null
    },
    {
      "evidence_id": "EV-002",
      "source_file_instance_id": "5577514a19f6917c",
      "page_number": 1,
      "printed_page_label": "Page 1 of 2",
      "section": "applicability",
      "section_raw": "Manufacturer(s) / Applicability",
      "clause_path": null,
      "exact_quote": "Manufacturer(s):\n      Airbus\n\n      Applicability:\n      Airbus A350-941 aeroplanes, all manufacturer serial numbers, except those on which Airbus\n      modification (mod) 111827 has been embodied in production.",
      "start_char": 1969,
      "end_char": 2181,
      "page_text_sha256": "737cdb59e091938c565b24e28faaae7400b7574e4db753d962c06dd2c28e4bdd",
      "bbox_normalized": null,
      "extraction_method": "native_text",
