      "printed_page_label": "Page 2 of 2",
      "section": "reference_publications",
      "section_raw": "Ref. Publications",
      "clause_path": null,
      "exact_quote": "Ref. Publications:\n     Airbus A380 MMEL MER, approv             al date 06 October 2020.\n\n     The use of later approved revisions of th          e above-mentioned document is acceptable fo                r compliance\n     with the requirements of this AD.",
      "start_char": 977,
      "end_char": 1234,
      "page_text_sha256": "79af8bd0edd43cb67dba8bf530ca3f0015a385688327c301f1e169ec141268c6",
      "bbox_normalized": null,
