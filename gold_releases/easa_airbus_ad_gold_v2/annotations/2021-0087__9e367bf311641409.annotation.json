      "clause_path": null,
      "exact_quote": "Manufacturer(s):\n      Airbus\n\n      Applicability:\n      Airbus A380-841 and A380-842 aeroplanes, all manufacturer serial numbers.",
      "start_char": 1972,
      "end_char": 2103,
      "page_text_sha256": "d10abd3c2e507705162c19d8d3df8c9cac0da90101079df65a80dc818e33795e",
