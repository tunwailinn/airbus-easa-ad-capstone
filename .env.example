# Hosted Layer C / live assistant configuration.
# Copy this file to `.env` and replace the placeholder locally.
# Never commit `.env`.

DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key

# Optional DeepSeek override; normally leave commented out.
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Post-evaluation assistant serving configuration.
# `auto` selects MPS on supported Apple Silicon and otherwise falls back safely.
ASSISTANT_DEVICE=auto
ASSISTANT_ML_CONCURRENCY=1

# Optional serving-snapshot overrides.
# ASSISTANT_INDEX_PATH=data_processed/serving/assistant_v1/e4_section_hybrid
# ASSISTANT_DENSE_PATH=data_processed/serving/assistant_v1/e5c_qwen3_embedding_0_6b
